# Supabase → Project → Connect → "Session pooler" → URI (use port 5432, not the 6543 transaction pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# LLM for the diagnosis and prompt-generation agents
# Default: Groq running GPT-OSS 20B (fast and cheap). Key: console.groq.com → API Keys
GEO_LLM_PROVIDER=groq
GEO_LLM_MODEL=openai/gpt-oss-20b          # openai/gpt-oss-120b if answers are too shallow
GEO_LLM_REASONING=low                     # low | medium | high (higher = better, more tokens)
GEO_LLM_MAX_OUTPUT=2500                   # free tier: keep low; paid tier: 6000+ with medium reasoning
GROQ_API_KEY=
# Alternatives: GEO_LLM_PROVIDER=anthropic (ANTHROPIC_API_KEY) or openai (OPENAI_API_KEY)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

GEO_MAX_UPLOAD_MB=50
